{
  "name": "SoundMark",
  "private": true,
  "scripts": {
    "start": "meteor run",
    "dev": "meteor run --settings private/settings.json",
    "test": "meteor test --once --driver-package meteortesting:mocha --settings private/settings.json",
    "test-app": "TEST_WATCH=1 meteor test --full-app --driver-package meteortesting:mocha --settings private/settings.json",
    "visualize": "meteor --production --extra-packages bundle-visualizer",
