    "@tailwindcss/postcss": "^4.3.3",
    "buffer": "^6.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.28.0",
    "meteor-node-stubs": "^1.2.12",
    "meyda": "^5.6.3",
    "postcss": "^8.5.25",
    "postcss-load-config": "^6.0.1",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
